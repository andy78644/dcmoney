{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcmoney",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcmoney",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
